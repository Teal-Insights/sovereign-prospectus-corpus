# Client-side base URL for MANIFEST.json, documents.parquet, text/<slug>.json.
# Dev default comes from the npm dev script (/data via the dev middleware).
# Production builds fail without an explicit https URL (localhost http is
# allowed for local measurement runs).
PUBLIC_DATA_BASE_URL=https://data.example.org/snapshot

# Build-time path to the snapshot dir (getStaticPaths + dev middleware).
# NOTE: read via loadEnv/process.env in astro.config.mjs; .env files are
# NOT auto-loaded inside config files, so export it in your shell or rely
# on the default ../data/snapshot.
SNAPSHOT_DIR=../data/snapshot

# Optional: serve the two DuckDB wasm binaries from a data host instead of
# the bundled dist assets (worker JS always stays same-origin). MUST point
# at a VERSIONED path (e.g. .../duckdb-wasm-1.32.0) served immutable:
# worker JS and wasm version together, and a stable URL under immutable
# caching would break returning visitors on the first version bump.
# PUBLIC_WASM_BASE_URL=https://data.example.org/wasm/duckdb-wasm-1.32.0

# Optional: self-host the DuckDB parquet extension instead of fetching it
# from extensions.duckdb.org on the first query. DuckDB appends its own
# <core-version>/<wasm-platform>/parquet.duckdb_extension.wasm suffix (the
# core version is the DuckDB build inside duckdb-wasm, e.g. v1.4.3 for
# 1.32.0, NOT the npm string), so this base is the parent of that tree.
# Version-bind it under the same duckdb-wasm-<v> prefix and re-run
# scripts/upload-extension.sh (wrapper) whenever the duckdb-wasm pin bumps.
# PUBLIC_EXTENSION_BASE_URL=https://data.example.org/wasm/duckdb-wasm-1.32.0/ext
