---
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  snapshotDate: string;
  generatedAt: string;
  description?: string;
}

// Default social/description text (B0 punch P9). A URL shared in a chat app
// this week unfurls from these tags; doc pages pass distinct titles, so
// og:title differentiates per document.
const DEFAULT_DESCRIPTION =
  'An open, searchable corpus of sovereign bond prospectuses and related filings from the FCA NSM, SEC EDGAR, the Luxembourg Stock Exchange, and the #PublicDebtIsPublic dataset.';
const { title, snapshotDate, generatedAt, description = DEFAULT_DESCRIPTION } = Astro.props;

// Brand slots (S4 theme contract): a private wrapper may drop
// Head.astro / Header.astro into src/brand/ at build time. Absent files
// mean the neutral defaults below; nothing here reads brand content.
type AstroComponent = (props: Record<string, never>) => unknown;
const brand = import.meta.glob<{ default: AstroComponent }>('../brand/*.astro', {
  eager: true,
});
const BrandHead = brand['../brand/Head.astro']?.default;
const BrandHeader = brand['../brand/Header.astro']?.default;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Sovereign Prospectus Explorer" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    {BrandHead && <BrandHead />}
  </head>
  <body data-build-generated-at={generatedAt} data-build-snapshot-date={snapshotDate}>
    {
      BrandHeader ? (
        <BrandHeader />
      ) : (
        <header class="ew-header">
          <a href="/">Sovereign Prospectus Explorer</a>
        </header>
      )
    }
    <main>
      <slot />
    </main>
    <footer class="ew-footer">
      Snapshot {snapshotDate}. Data and code:{' '}
      <a href="https://github.com/Teal-Insights/sovereign-prospectus-corpus" rel="noopener"
        >sovereign-prospectus-corpus</a
      >.
    </footer>
  </body>
</html>
