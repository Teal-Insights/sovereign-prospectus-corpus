---
import SearchSlot from '../components/SearchSlot.astro';
import Base from '../layouts/Base.astro';
import { computeFilterOptions, computeStats, loadDocuments, loadSnapshotManifest } from '../lib/build-data';
import {
  HI_TOGGLE_LABEL,
  NOSCRIPT_NOTE,
  SEARCH_LABEL,
  SEARCH_PLACEHOLDER,
  WB_VINTAGE_NOTE,
  browseSubtitle,
  scopeToggleLabel,
  sourceDisplay,
  statsCaption,
} from '../lib/format';

const [docs, stamp] = await Promise.all([loadDocuments(), loadSnapshotManifest()]);
const stats = computeStats(docs);
const options = computeFilterOptions(docs);
const n = (v: number) => v.toLocaleString('en-US');

const GITHUB_URL = 'https://github.com/Teal-Insights/sovereign-prospectus-corpus';
---

<Base
  title="Sovereign Prospectus Explorer"
  snapshotDate={stamp.snapshot_date}
  generatedAt={stamp.generated_at}
>
  <h1>Sovereign Prospectus Explorer</h1>
  <p class="ew-muted">{browseSubtitle(stats.sovereign, stats.related)}</p>

  <div class="ew-stats" aria-label="Corpus statistics">
    <div class="ew-stat"><span class="ew-stat-value">{n(stats.docs)}</span> Documents</div>
    <div class="ew-stat"><span class="ew-stat-value">{n(stats.sources)}</span> Sources</div>
    <div class="ew-stat"><span class="ew-stat-value">{n(stats.issuers)}</span> Issuers</div>
    <p class="ew-muted ew-stats-caption">{statsCaption(stamp.snapshot_date)}</p>
  </div>

  <details class="ew-about">
    <summary>About this project</summary>
    <p>
      The Sovereign Prospectus Explorer is an open corpus of sovereign bond
      prospectuses and related filings, collected from the FCA National Storage
      Mechanism, SEC EDGAR, the Luxembourg Stock Exchange, and the Sovereign
      Debt Forum's #PublicDebtIsPublic dataset. Every document links back to its
      source. Built by
      <a href="https://tealinsights.com" target="_blank" rel="noopener noreferrer">Teal Insights</a>
      with support from
      <a href="https://naturefinance.net" target="_blank" rel="noopener noreferrer">NatureFinance</a>.
      <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a> |
      <a href={`${GITHUB_URL}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">MIT License</a>.
    </p>
    <p>
      These are public documents, but working with them is not easy: they sit
      scattered across venues, behind slow search interfaces, in inconsistent
      formats. The explorer puts them in one place with fast filtering, readable
      text, and in-document search, so the ten pages that matter in a
      300-page document take minutes to reach, not hours.
    </p>
    <h3>What's next</h3>
    <ul>
      <li>Search across the full text of every document in the corpus</li>
      <li>Automated updates as new prospectuses are filed</li>
      <li>Document-type filters (base prospectus, supplement, final terms)</li>
      <li>
        Clause identification with expert validation, measured against
        expert-annotated baselines before any claim ships
      </li>
    </ul>
    <h3>Help shape this tool</h3>
    <p>
      This is built with and for the people who work with sovereign debt:
      lawyers, investors, officials, and researchers. If it could work better
      for you, <a href="mailto:lte@tealinsights.com">tell us</a> or open an
      issue on
      <a href={`${GITHUB_URL}/issues`} target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>
  </details>

  <SearchSlot />

  <noscript><p class="ew-notice">{NOSCRIPT_NOTE}</p></noscript>

  <div id="ew-browse-notices"></div>

  <div class="ew-search">
    <label class="ew-search-label" for="ew-search-input">{SEARCH_LABEL}</label>
    <input
      type="search"
      id="ew-search-input"
      class="ew-search-input"
      placeholder={SEARCH_PLACEHOLDER}
      autocomplete="off"
      enterkeyhint="search"
      maxlength="200"
    />
  </div>

  <form id="ew-filters" class="ew-filters">
    <div class="ew-filter-group">
      <label
        >Country
        <select id="ew-filter-country-select">
          <option value="">Add country...</option>
          {options.countries.map((c) => <option value={c.code}>{c.name}</option>)}
        </select>
      </label>
      <ul class="ew-chips" id="ew-filter-country-chips" aria-label="Selected countries"></ul>
    </div>
    <div class="ew-filter-group">
      <label
        >Region
        <select id="ew-filter-region-select">
          <option value="">Add region...</option>
          {options.regions.map((r) => <option value={r}>{r}</option>)}
        </select>
      </label>
      <ul class="ew-chips" id="ew-filter-region-chips" aria-label="Selected regions"></ul>
    </div>
    <div class="ew-filter-group">
      <label
        >Income group
        <select id="ew-filter-income-select">
          <option value="">Add income group...</option>
          {options.incomes.map((i) => <option value={i}>{i}</option>)}
        </select>
      </label>
      <ul class="ew-chips" id="ew-filter-income-chips" aria-label="Selected income groups"></ul>
    </div>
    <div class="ew-filter-group">
      <label
        >Source
        <select id="ew-filter-source-select">
          <option value="">Add source...</option>
          {options.sources.map((s) => <option value={s}>{sourceDisplay(s)}</option>)}
        </select>
      </label>
      <ul class="ew-chips" id="ew-filter-source-chips" aria-label="Selected sources"></ul>
    </div>
    <div class="ew-toggles">
      <label class="ew-check-row">
        <input type="checkbox" id="ew-scope-toggle" />
        {scopeToggleLabel(stats.related)}
      </label>
      <label class="ew-check-row">
        <input type="checkbox" id="ew-hi-toggle" />
        {HI_TOGGLE_LABEL}
      </label>
      <span id="ew-hi-hint"></span>
    </div>
  </form>
  <p class="ew-muted">{WB_VINTAGE_NOTE}</p>

  <p id="ew-status" class="ew-muted" aria-live="polite">Loading the document index...</p>

  <div id="ew-table-region" tabindex="-1">
    <table id="ew-table" hidden>
      <thead>
        <tr>
          <th class="ew-col-date">Date</th>
          <th class="ew-col-issuer">Issuer</th>
          <th class="ew-col-country">Country</th>
          <th class="ew-col-type">Type</th>
          <th class="ew-col-source">Source</th>
          <th class="ew-col-status">Status</th>
        </tr>
      </thead>
      <tbody id="ew-rows"></tbody>
    </table>
  </div>

  <p>
    <button id="ew-prev" hidden>Previous</button>
    <button id="ew-next" hidden>Next</button>
  </p>
</Base>

<script>
  import '../scripts/browse';
</script>

<style>
  .ew-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--ew-space-4);
    margin: var(--ew-space-3) 0;
  }
  .ew-stat-value {
    font-size: var(--ew-font-size-h1);
    font-weight: 600;
    margin-right: var(--ew-space-1);
  }
  .ew-stats-caption {
    flex-basis: 100%;
    margin: 0;
  }
  /* About box shell (B0 punch P8, route B6): restyle only. B3 owns the
     copy. Roomier padding, a reading measure on every block but the
     summary, and an accent-colored summary that reads as a real
     disclosure affordance. */
  .ew-about {
    margin: var(--ew-space-3) 0;
    padding: var(--ew-space-3) var(--ew-space-4);
    border: 1px solid var(--ew-color-border);
    border-radius: var(--ew-radius);
    background: var(--ew-color-surface);
  }
  .ew-about > :not(summary) {
    max-width: 70ch;
  }
  .ew-about summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--ew-color-accent);
  }
  .ew-about summary:hover {
    text-decoration: underline;
  }
  .ew-about[open] summary {
    margin-bottom: var(--ew-space-2);
  }
  .ew-search {
    display: flex;
    flex-direction: column;
    gap: var(--ew-space-1);
    margin: var(--ew-space-3) 0 0;
  }
  .ew-search-label {
    font-size: var(--ew-font-size-small);
    color: var(--ew-color-text-muted);
  }
  .ew-search-input {
    max-width: 28rem;
    padding: var(--ew-space-1) var(--ew-space-2);
  }
  .ew-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ew-space-3);
    align-items: start;
    margin: var(--ew-space-3) 0 var(--ew-space-1);
  }
  .ew-filter-group label {
    display: flex;
    flex-direction: column;
    gap: var(--ew-space-1);
    font-size: var(--ew-font-size-small);
    color: var(--ew-color-text-muted);
  }
  .ew-toggles {
    display: flex;
    flex-direction: column;
    gap: var(--ew-space-1);
    font-size: var(--ew-font-size-small);
  }
  .ew-check-row {
    display: flex;
    align-items: center;
    gap: var(--ew-space-2);
  }
</style>
