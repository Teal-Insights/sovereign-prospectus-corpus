---
// Document text region. The provenance block is pre-rendered (static HTML):
// it must survive JS failure, printing, and archiving. Text itself is
// fetched client-side by scripts/doc-text.ts, which renders into the
// #ew-doc-text container (tabindex -1 is REQUIRED so TOC jumps and match
// navigation can move keyboard focus into the text) and keeps the raw string
// reachable via window.__ewDoc. The container is a single text node in plain
// and segmented modes and a rendered HTML tree in rendered mode; see the
// mode-scoped contract in env.d.ts and ARCHITECTURE.md.

import {
  DOC_NOSCRIPT_NOTE,
  NO_PAGE_ANCHORS_NOTE,
  NO_TOC_LABEL,
  PAGES_NOT_DISPLAYED_NOTE,
  PROVENANCE_NOTE,
  TOC_FILTER_PLACEHOLDER,
  VIEW_RAW_LABEL,
  filingLinkLabel,
  orNA,
} from '../lib/format';

interface Props {
  slug: string;
  hasText: boolean;
  textBytes: number | null;
  textSource: string | null;
  noTextReason: string | null;
  filingUrl: string | null;
  source: string | null;
}
const { slug, hasText, textBytes, textSource, noTextReason, filingUrl, source } = Astro.props;
const filingLabel = filingLinkLabel(source);
---

<section aria-labelledby="ew-doc-text-heading">
  <h2 id="ew-doc-text-heading">Document text</h2>

  <div id="ew-doc-notices"></div>
  <div id="ew-doc-live" class="ew-sr-only" aria-live="polite"></div>

  {
    hasText ? (
      <>
        <div class="ew-notice">
          {PROVENANCE_NOTE}
          {filingUrl && (
            <>
              {' '}
              <a href={filingUrl} rel="noopener">{filingLabel}</a>.
            </>
          )}
          {' '}Text source: {orNA(textSource)}.
          {textSource === 'markdown' && <> {NO_PAGE_ANCHORS_NOTE}</>}
          {textSource === 'pages' && <> {PAGES_NOT_DISPLAYED_NOTE}</>}
        </div>
        <noscript><p class="ew-notice">{DOC_NOSCRIPT_NOTE}</p></noscript>

        <div class="ew-doc-search">
          <label
            >Search within this document
            <input
              id="ew-doc-search-input"
              type="search"
              placeholder="Find text in this prospectus..."
              autocomplete="off"
              aria-describedby="ew-doc-search-hint"
              disabled
            />
          </label>
          <button id="ew-doc-search-prev" type="button" hidden>Previous match</button>
          <button id="ew-doc-search-next" type="button" hidden>Next match</button>
          <span id="ew-doc-search-count" class="ew-muted"></span>
          <span id="ew-doc-search-pos" class="ew-muted"></span>
          <p id="ew-doc-search-hint" class="ew-muted" hidden></p>
        </div>

        <details id="ew-doc-toc-details">
          <summary>Contents</summary>
          <input
            id="ew-doc-toc-filter"
            type="search"
            hidden
            aria-label="Filter table of contents"
            placeholder={TOC_FILTER_PLACEHOLDER}
            autocomplete="off"
          />
          <ol id="ew-doc-toc" class="ew-muted" data-empty-label={NO_TOC_LABEL}></ol>
        </details>

        <p id="ew-seg-nav" hidden>
          <button id="ew-seg-prev" type="button">Previous segment</button>
          <span id="ew-seg-label"></span>
          <button id="ew-seg-next" type="button">Next segment</button>
        </p>
        <div id="ew-seg-notice"></div>

        <p id="ew-view-toggle-row" hidden>
          <button id="ew-view-toggle" type="button" hidden>{VIEW_RAW_LABEL}</button>
        </p>

        <div
          id="ew-doc-text"
          tabindex="-1"
          data-slug={slug}
          data-text-bytes={textBytes ?? 0}
          data-text-source={textSource}
          data-seg-start="0"
        >
          Loading...
        </div>
      </>
    ) : (
      <p class="ew-muted">No text available for this document: {orNA(noTextReason)}.</p>
    )
  }
</section>

<script>
  import '../scripts/doc-text';
</script>

<style>
  .ew-doc-search {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--ew-space-2);
    margin: var(--ew-space-3) 0;
  }
  .ew-doc-search label {
    display: flex;
    flex-direction: column;
    gap: var(--ew-space-1);
    font-size: var(--ew-font-size-small);
    color: var(--ew-color-text-muted);
  }
  #ew-doc-toc-details {
    margin: var(--ew-space-2) 0;
  }
  #ew-doc-toc-details summary {
    cursor: pointer;
    font-weight: 600;
  }
  /* :not([hidden]) keeps the hidden attribute effective: a bare display
     rule would override the UA's [hidden] display: none. */
  #ew-seg-nav:not([hidden]) {
    display: flex;
    align-items: center;
    gap: var(--ew-space-2);
  }
</style>
